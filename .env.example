# Copy to .env locally. Never commit .env or credentials.
# The only required setting for collection. Leave blank to review the empty UI.
VAST_API_KEY=

# Optional overrides (defaults shown). HOST covers all IPv4 interfaces.
# HOST=0.0.0.0
# PORT=3000
# DATA_DIR=./var/data
# MARKET_ENABLED=1
# DEVICES_PRIVATE=1
# VASTSTATS_SETTINGS_TOKEN=
